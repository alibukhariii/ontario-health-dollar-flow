{
  "name": "ontario-health-dollar-flow",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:data": "python3 scripts/build_data.py",
    "build:public-inputs": "python3 scripts/prepare_public_inputs.py",
    "build:release": "python3 scripts/build_public_release.py",
    "build": "python3 scripts/build_site.py",
    "serve": "python3 -m http.server 4173 -d dist"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  }
}
